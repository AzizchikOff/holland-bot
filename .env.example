# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin Telegram ID (@userinfobot dan olinadi)
ADMIN_ID=123456789

# MongoDB ulanish manzili (MongoDB Atlas)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/holland

# Admin panel paroli — MAJBURIY, default yo'q
ADMIN_PASS=kuchli_parol_kiriting

# Token imzolash uchun maxfiy kalit (ixtiyoriy, lekin tavsiya etiladi)
TOKEN_SECRET=tasodifiy_uzun_satr

# Webhook manzili (production uchun; bo'sh qoldirsangiz polling ishlaydi)
WEBHOOK_URL=https://holland-bot.onrender.com

# Mini App manzili
MINI_APP_URL=https://holland-namangan.netlify.app/app/

# Rasmlar bazaviy manzili
IMG_BASE=https://holland-namangan.netlify.app/images

# Server porti
PORT=3000